BasedOnStyle: LLVM  # 基于LLVM风格，在此基础上修改
IndentWidth: 2      # 缩进宽度为2个空格
TabWidth: 2         # Tab键对应的宽度
UseTab: Never       # 禁用Tab，全部用空格缩进
ColumnLimit: 120    # 代码行最大长度
BreakBeforeBraces: Attach  # 大括号紧跟语句
SpaceAfterControlStatementKeyword: true  # if/for等关键字后加空格

# include 分组：测试用的 "check.hpp" 属于本仓库的本地头，排在最前；标准库次之。
#
# 库本身不再用 #include 引入——模块化之后一律 `import maths.xxx;`。
# import 必须写在所有 #include 之后（反过来 clang 会在标准库头里报错），
# clang-format 不会把 import 挪到 #include 之前，所以这个顺序是安全的。
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"check\.hpp"'
    Priority: 1
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 2