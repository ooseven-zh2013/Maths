# clangd 配置 —— 对 mcpp 生成的 compile_commands.json 做增量修正
#
# 编译命令的权威来源是仓库根的 compile_commands.json（`mcpp build` 生成，已列在
# .gitignore 里）。clangd 优先用它，本文件只做修正与编辑器行为设置。
#
# 刻意**不**设 CompileFlags.Compiler：
#   - 有 compile_commands.json 时它会把数据库里的真实编译器（mcpp 沙箱里的 clang++）
#     顶掉，换成被指定的驱动模式（2026-09-27 实测：原来的 `Compiler: "g++"` 让 clangd
#     改用 `--driver-mode=g++` 重新解析，而本项目实际按 MSVC 目标构建）
#   - 写绝对路径不可移植（各人 LLVM 装在哪不一样），本文件是要提交的
#
# 已知局限（2026-09-27 实测，别再重复排查）：
#   工具链是 clang 20.1.7，产出的 PCM（std.pcm / maths.pcm …）本机 clangd 22.1.8
#   加载不了，报 `ast_file_version_too_old`；而 import 失败会连带把整个文件判成
#   "标识符未定义"（实测一个 .cpp 衍生 20 条错）。这与当初删掉 CI 里 clang-tidy job
#   是同一个根因；mcpp 的 llvm 包又是精简版、**不含 clangd**，所以没法让编辑器直接
#   用工具链自带的那个 clangd。
#   现状：剥掉模块缓存标志 + 屏蔽 module_not_found（见下），全项目 29 个源文件
#   **零真实诊断**。代价是 `import maths;` / `import std;` 带来的类型没有补全与跳转。
#   要真正拿回补全/跳转只有一条路：装一个与工具链同版本的 clangd（LLVM 20.1.7），
#   让编辑器用它（VS Code 是 clangd.path，其他编辑器同理）。届时下面那三条 Remove
#   和 Suppress 都可以撤掉，clangd 会直接读工具链产出的 .pcm。
#   不建议开 `--experimental-modules-support`：它要现场编译整个 std 模块，
#   实测 `--check` 跑 5 分钟仍未完成。

CompileFlags:
  Add:
    - "-Wall"            # 与 mcpp.toml 的 [build].cxxflags 对齐
    - "-Wextra"
    - "-std=c++23"       # 有数据库时是重复的，给没有 compile_commands.json 的场景兜底
  Remove:
    - "-Werror"          # 不把警告当错误，避免编辑器里一行警告红一片
    # ⚠️ 这里**曾经**剥掉过 `-fmodule-file=*` / `-fprebuilt-module-path=*` /
    # `-fmodule-output=*` 三条模块缓存标志，为的是让 clangd 别去啃版本对不上的 .pcm
    # —— 当时本机是 clangd 22，工具链是 20.1.7，PCM 加载不了，
    # 一个 .cpp 能衍生 20 条「标识符未定义」。
    #
    # 现在不需要了：编辑器改用 **与工具链同版本的 clangd 20.1.7**
    # （`E://Tools//clangd-20.1.7//`，见 .vscode/settings.json 的 clangd.path），
    # PCM 直接能读，那三条剥掉反而**害得 `import maths;` 的类型全都没有补全与跳转**。
    # 工具链换了版本、而这里的版本没跟着换的话，就会退回「一个 .cpp 衍生 20 条错」的老症状
    # —— 那种错法很有辨识度，看到先查 clangd 版本。

# 索引设置 - 控制代码索引行为
Index:
  Background: "Build"    # 在后台构建过程中进行索引，提高代码导航性能

# 诊断设置
#
# 这里**刻意不设 `Diagnostics`**：
#   - 检查集只由仓库根的 .clang-tidy 决定（原先这里另有一套 Add/Remove，与它互相
#     打架：这里打开 readability-implicit-bool-conversion，.clang-tidy 那边明确关掉，
#     同一份代码两处结论相反）
#   - 曾经在这里 Suppress 掉 module_not_found（当时 clangd 与工具链版本错配的产物），
#     同版本 clangd 用上后就不需要了 —— 留着反而会盖住「模块名真写错」这种真错误
#
# ⚠️ `Diagnostics:` 底下只剩注释行是不行的 —— clangd 会报
# `config error: Diagnostics should be a dictionary`。要删就整段删干净。

# 代码提示设置部分 - 在编辑器中显示辅助信息
InlayHints:
  Enabled: true          # 启用内联提示功能
  ParameterNames: true   # 显示函数参数名称提示
  DeducedTypes: true     # 显示类型推导结果提示
  Designators: true      # 显示结构体/类初始化器的设计器提示

# 代码补全设置部分 - 控制自动补全行为
Completion:
  AllScopes: true        # 启用所有作用域的代码补全，包括私有成员
